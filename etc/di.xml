<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Di-merge the Okta normalizer into admin-scim's provider-quirk seam. -->
    <type name="MageDevGroup\AdminScim\Model\Normalization\RequestNormalizerChain">
        <arguments>
            <argument name="normalizers" xsi:type="array">
                <item name="okta" xsi:type="object">MageDevGroup\AdminScimOkta\Model\Normalization\OktaRequestNormalizer</item>
            </argument>
        </arguments>
    </type>
</config>
